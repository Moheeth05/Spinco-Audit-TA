{
  "name": "spinco-ta-audit",
  "productName": "Spinco TA Audit",
  "version": "1.2.2",
  "description": "SPINCO TA / Travel Expense Audit & Automation System - desktop application",
  "private": true,
  "main": "electron/main.js",
  "author": "Spinco Tech",
  "scripts": {
    "clean": "node electron/scripts/clean.js",
    "write:build-info": "node electron/scripts/write-build-info.js",
    "test:backend": "node electron/scripts/run-tests.js",
    "build:frontend": "npm run build --prefix frontend",
    "build:backend": "node electron/scripts/build-backend.js",
    "collect:tesseract": "node electron/scripts/collect-tesseract.js",
    "electron:dev": "electron .",
    "prepackage": "npm run clean && npm run write:build-info && npm run build:frontend && npm run build:backend && npm run collect:tesseract",
    "verify:release": "node electron/scripts/verify-release.js",
    "dist": "npm run test:backend && npm run prepackage && electron-builder --win && npm run verify:release",
    "dist:portable": "npm run prepackage && electron-builder --win portable",
    "release:stage": "node electron/scripts/stage-release.js"
  },
  "devDependencies": {
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8",
    "js-yaml": "^5.4.2"
  },
  "build": {
    "appId": "com.spincotech.ta-audit",
    "productName": "Spinco TA Audit",
    "directories": {
      "output": "release",
      "buildResources": "electron/build"
    },
    "files": [
      "electron/main.js",
      "electron/preload.js",
      "electron/updater.js",
      "!electron/scripts/**",
      "!**/node_modules/electron-builder/**"
    ],
    "extraResources": [
      {
        "from": "frontend/dist",
        "to": "frontend"
      },
      {
        "from": "backend/dist_backend/spinco-backend",
        "to": "backend"
      },
      {
        "from": "resources/tesseract",
        "to": "tesseract"
      },
      {
        "from": "electron/generated/build-info.json",
        "to": "build-info.json"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "electron/build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Spinco TA Audit"
    },
    "publish": {
      "provider": "generic",
      "url": "https://spinco-central.example/updates/spinco-ta-audit/",
      "channel": "latest"
    }
  },
  "allowScripts": {
    "electron@33.4.11": true
  },
  "dependencies": {
    "electron-log": "^5.4.4",
    "electron-updater": "^6.8.9"
  }
}
