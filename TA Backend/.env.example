# Copy to ".env" and edit. Real environment variables override this file.

# 127.0.0.1 = this computer only (default). Use 0.0.0.0 on a server (then TA_API_KEY is REQUIRED).
HOST=127.0.0.1
PORT=4000

# Where PDFs and index.json are kept (relative to this folder, or an absolute path). Back this folder up.
STORAGE_DIR=storage

# API key(s), 16+ characters, comma-separated to allow several. Clients send:  Authorization: Bearer <key>
# Generate one:  node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
TA_API_KEY=

# OPTIONAL folder sync: copy every PDF found in this folder into the storage above, sorted and de-duplicated. Use it to
# collect what the desktop app saved (it has expense_reports\ and trip_reports\ inside). The folder is only read.
#   desktop app:  SYNC_FOLDER=C:\Users\<you>\AppData\Roaming\Spinco TA Audit\documents      dev servers: D:\Bills\storage
SYNC_FOLDER=
SYNC_INTERVAL_SECONDS=30

# Limits. 25 MB per PDF is the software's own limit.
MAX_FILE_MB=25
MAX_REQUEST_MB=150

# Only if a browser app on ANOTHER origin calls this server, e.g. https://ta.example.com (leave empty otherwise).
CORS_ORIGIN=
