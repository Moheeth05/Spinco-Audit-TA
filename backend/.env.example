# Spinco TA Audit - backend environment configuration template.
#
# Copy this file to `.env` (same directory) and fill in real values there.
# `.env` is gitignored - never commit real credentials. This file is the
# only one that should ever be committed, and it must never contain a real
# secret value.
#
# For local development, start uvicorn with --env-file so it loads this
# file BEFORE the app imports (uvicorn's own --env-file flag, not app code -
# deliberately NOT auto-loaded inside app/main.py, since that would also
# load it during every pytest run and make tests depend on whatever happens
# to be in a developer's local .env):
#   uvicorn app.main:app --reload --env-file .env
# The packaged Electron app does NOT read this file; it sets its own
# SPINCO_* variables directly on the backend subprocess (see
# electron/main.js) - for a packaged build, the vars below must instead be
# set as real OS/user environment variables before launching the app.
#
# Every provider below is STRICTLY OPT-IN, DISABLED BY DEFAULT: it is used
# only when its API key is set AND its *_ENABLED flag is explicitly "true".
# A missing, empty, "false" or unrecognised flag means disabled, and a key
# alone never enables anything. The flag is re-checked inside each provider
# call, so no code path can reach the network while it is off. Provider
# flags: SPINCO_NVIDIA_ENABLED (shared by NVIDIA OCR, the NVIDIA text
# fallback and the NVIDIA page classifier) and SPINCO_DEEPSEEK_ENABLED -
# enabling one never enables the other. Endpoint overrides must be https
# (plain http only to localhost, for local mock servers); anything else is
# ignored and no request is sent. Enabling a provider means the relevant
# document image or extracted bill text will be sent to that external
# service - see docs before enabling in an environment with real company
# expense documents.
#
# The packaged Electron app forces both flags to "false" for its backend
# regardless of the launching environment (see electron/main.js); enabling a
# provider in a packaged build needs a deliberate, separate change (secure
# credential storage is a future task, not covered here).

# ---------- NVIDIA OCR (Nemotron OCR v2) ----------
# Image-to-text OCR fallback for scanned/handwritten pages that local
# Tesseract reads with too little or too-low-confidence text. Used ONLY for
# OCR (recovering raw text from an image) - never for field interpretation.
# Confirmed endpoint: https://ai.api.nvidia.com/v1/cv/nvidia/nemotron-ocr-v2
SPINCO_NVIDIA_API_KEY=
SPINCO_NVIDIA_ENABLED=false
# Optional overrides - leave unset to use the documented defaults above.
# SPINCO_NVIDIA_OCR_ENDPOINT=
# SPINCO_NVIDIA_OCR_MODEL=nvidia/nemotron-ocr-v2

# ---------- NVIDIA structured-extraction fallback (optional, legacy) ----------
# Same SPINCO_NVIDIA_API_KEY/SPINCO_NVIDIA_ENABLED above also gate this -
# a separate, OpenAI-compatible chat-completions call that fills in
# missing amount/date/vendor fields from a bill's own extracted text, used
# only when DeepSeek (below) is not configured. Kept for a deployment that
# only has an NVIDIA key, not a DeepSeek one.
# SPINCO_NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
# SPINCO_NVIDIA_MODEL=meta/llama-3.1-70b-instruct

# ---------- DeepSeek (via DeepInfra) structured-extraction fallback ----------
# Text-only field-interpretation fallback for the same role as the NVIDIA
# fallback above - fills in amount/date/vendor/category-evidence a bill's
# OCR text didn't deterministically yield. Preferred over the NVIDIA
# fallback when both are configured (see bill_parser.py). Never receives an
# image - text only.
SPINCO_DEEPSEEK_API_KEY=
SPINCO_DEEPSEEK_ENABLED=false
# Optional overrides - leave unset to use the documented defaults.
# SPINCO_DEEPSEEK_BASE_URL=https://api.deepinfra.com/v1/openai
# SPINCO_DEEPSEEK_MODEL=deepseek-ai/DeepSeek-V3
# SPINCO_DEEPSEEK_SERVICE_TIER=flex
# Google Drive central storage (Phase 2 TEST integration; off unless enabled). The service-account key file must live OUTSIDE the
# repository and is referenced by PATH only - never put key material in this file, in Git, in Electron or in the frontend.
# SPINCO_GDRIVE_ENABLED=true
# SPINCO_GDRIVE_ROOT_FOLDER_ID=<test folder id>
# SPINCO_GDRIVE_CREDENTIALS_FILE=D:\SPINCO-SECRETS\spinco-drive-test-sa.json
# SPINCO_GDRIVE_SPOOL_DIR=<server-only folder used to keep an upload's bytes until Drive has confirmed them>
# Sign-in mode (Phase 2.2). The default, service_account, uses the key file above. oauth_user signs in as a company user through the
# Desktop-client file and the refresh-token file (created by backend/drive_spike/oauth_authorize.py --authorize); both live OUTSIDE the repository.
# SPINCO_GDRIVE_AUTH_MODE=service_account
# SPINCO_GDRIVE_OAUTH_CLIENT_FILE=D:\SPINCO-SECRETS\spinco-drive-oauth-desktop.json
# SPINCO_GDRIVE_OAUTH_TOKEN_FILE=D:\SPINCO-SECRETS\spinco-drive-oauth-token.json
# Destination guard (Phase 3A.1) - REQUIRED whenever Drive is enabled. Each environment names the ONE Shared Drive it may write to. The id is
# environment-SCOPED on purpose: production never inherits the staging id, and an id shared by two environments is refused. Nothing is written
# unless Google confirms the configured folder (and its whole parent chain) is inside that Shared Drive.
# SPINCO_ENVIRONMENT=staging
# SPINCO_GDRIVE_EXPECTED_DRIVE_ID_STAGING=<Shared Drive id of the staging drive>
# SPINCO_GDRIVE_EXPECTED_DRIVE_ID_PRODUCTION=<Shared Drive id of the production drive - never the staging id>
# SPINCO_GDRIVE_GUARD_TTL_SECONDS=300
# While Google cannot be reached to verify the destination, writes are refused immediately for this many seconds instead of each waiting for the outage:
# SPINCO_GDRIVE_GUARD_FAILURE_WINDOW_SECONDS=15
# One destination verification (all of its reads together) is abandoned after this many seconds (writes are then refused, never delayed further):
# SPINCO_GDRIVE_GUARD_VERIFY_DEADLINE_SECONDS=15
# A pending upload that keeps failing is retried at most this many times, pausing 60 s after the first failure and doubling each time (up to 1 hour),
# then it is marked FAILED with its bytes kept; uploading the same file again (or an administrator's retry) starts a fresh budget:
# SPINCO_GDRIVE_MAX_UPLOAD_ATTEMPTS=10
# SPINCO_GDRIVE_UPLOAD_RETRY_BACKOFF_SECONDS=60
# Google sign-in (access-token refresh). ONE thread refreshes at a time; the others keep using the still-valid token. A whole refresh (file checks,
# retries and pauses included) is abandoned after this many seconds - it can be lowered (2-15) but never raised above 15:
# SPINCO_GDRIVE_TOKEN_DEADLINE_SECONDS=15
# Upper limit of the read phase of one token request:
# SPINCO_GDRIVE_TOKEN_TIMEOUT_SECONDS=10
# A thread that has no usable token waits at most this long behind the refreshing thread, then fails (retryably):
# SPINCO_GDRIVE_TOKEN_WAIT_SECONDS=2
# A refresh that failed for a transient reason is remembered this long, so a failing token endpoint is asked once per window, not once per thread:
# SPINCO_GDRIVE_TOKEN_FAILURE_WINDOW_SECONDS=10
#
# ---- CENTRAL STORAGE (central backend mode; everything below is OFF by default) ----------------------------------------------------------------------------
# off (default): the application behaves exactly as before (local files, local background tasks). shadow: local storage stays authoritative and every upload is
# ALSO copied to Drive by a durable background job. serve: Drive is authoritative - an upload succeeds only after the verified Drive copy exists, and list / preview /
# download use the central record only (a local copy is never served in its place). A misspelt value is refused and treated as off. serve and shadow also require
# SPINCO_GDRIVE_* above and a database that already has the central tables (they refuse to start otherwise; see docs/central-architecture/CENTRAL-BACKEND-SETUP.md).
# SPINCO_CENTRAL_STORAGE_MODE=off
# What happens to an exact duplicate upload: metadata (default) records the attempt only; copy ALSO keeps the duplicate's bytes in the Drive "Duplicates" folder.
# SPINCO_DUPLICATE_RETENTION=metadata
# SPINCO_JOB_WORKER=on            # off = do not start the background worker thread in this process (a dedicated worker process, or tests)
# SPINCO_SCHEMA_MODE=legacy       # strict = never create or alter tables at start-up, only verify them (always strict when central storage is on)
# Network exposure. Unset = loopback only (the desktop app). To run as the shared CENTRAL backend: bind to an interface, use a host NAME (not an IP), and an explicit
# strong initial administrator password. The backend REFUSES to start on a network address with the development default password, or without HTTPS unless
# SPINCO_ALLOW_INSECURE_HTTP=true is set (development / synthetic documents ONLY).
# SPINCO_BIND_HOST=0.0.0.0
# SPINCO_ALLOWED_HOSTS=ta-central.example.company
# SPINCO_ADMIN_INITIAL_PASSWORD=<explicit password, at least 12 characters>
# SPINCO_COOKIE_SECURE=true       # required once the backend is served over HTTPS
# SPINCO_ALLOW_INSECURE_HTTP=false


# ---------------------------------------------------------------------------
# Release candidate: central SERVER settings (see the deployment guide). All
# optional for the desktop app and for development; none of them is read by
# the Electron client. Never put real values in this file or commit them.
# ---------------------------------------------------------------------------
# Database for the company server (PostgreSQL). Use the FILE form so the password
# is not in the process environment. Never combine with SPINCO_DB_PATH.
# SPINCO_DATABASE_URL_FILE=C:\ProgramData\Spinco\secrets\database-url.txt
# SPINCO_DB_POOL_SIZE=10
# SPINCO_DB_MAX_OVERFLOW=20
# Production only: run on SQLite anyway (not recommended, refused by default)
# SPINCO_ALLOW_SQLITE_IN_PRODUCTION=true
#
# Network / HTTPS (production REQUIRES the cookie flag + allowed hosts; plain-HTTP acknowledgement is refused)
# SPINCO_ENVIRONMENT=production
# SPINCO_BACKEND_PORT=8001
# SPINCO_ALLOWED_HOSTS=spinco.company.example
# SPINCO_COOKIE_SECURE=true
# SPINCO_TRUSTED_PROXY_IPS=127.0.0.1
# SPINCO_CORS_ORIGINS=            (leave empty: the desktop app is served by the backend itself, same-origin)
#
# Google Drive sign-in for production: Workload Identity Federation (no key on the server)
# SPINCO_GDRIVE_AUTH_MODE=external_account
# SPINCO_GDRIVE_WIF_CONFIG_FILE=C:\ProgramData\Spinco\secrets\wif-config.json
#
# Limits and protection
# SPINCO_MAX_UPLOAD_MB=25
# SPINCO_MAX_REQUEST_MB=512
# SPINCO_LOGIN_MAX_FAILURES=5
# SPINCO_LOGIN_WINDOW_SECONDS=300
# SPINCO_LOGIN_LOCKOUT_SECONDS=300
#
# Logging (messages are redacted of tokens / passwords / keys before they are written)
# SPINCO_LOG_DIR=D:\SpincoData\logs
# SPINCO_LOG_LEVEL=INFO