# Node
node_modules/
dist/
dist-electron/
release/

# Staged self-hosted update feed (electron/scripts/stage-release.js) - built
# artifacts only, published externally, never committed here.
update-feed/

# PyInstaller backend build output
backend/build/
backend/dist_backend/

# Vendored Tesseract OCR runtime (fetched from the local machine at package
# time by electron/scripts/collect-tesseract.js - see that script's header
# comment for how to regenerate this directory; not committed since it is
# ~100MB of third-party binaries, not project source)
resources/tesseract/

# Python
__pycache__/
*.pyc
.venv/
venv/
*.egg-info/

# Database
*.db
*.sqlite
*.sqlite3

# Storage (uploaded/generated documents)
storage/expense_reports/*
storage/trip_reports/*
storage/excel/*
storage/processed/*
storage/logs/*
!storage/**/.gitkeep

# Env
.env
.env.local

# Editor/OS
.vscode/
.idea/
Thumbs.db
.DS_Store

# Logs
*.log
