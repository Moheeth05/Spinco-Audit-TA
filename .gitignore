# Node
node_modules/
dist/
dist-electron/
release/

# Staged self-hosted update feed (electron/scripts/stage-release.js) - built
# artifacts only, published externally, never committed here.
update-feed/

# PyInstaller backend build output
backend/build/
backend/dist_backend/

# Generated at build time (electron/scripts/write-build-info.js) - a fresh
# git-commit/build-date stamp every build, never a source file
electron/generated/

# Vendored Tesseract OCR runtime (fetched from the local machine at package
# time by electron/scripts/collect-tesseract.js - see that script's header
# comment for how to regenerate this directory; not committed since it is
# ~100MB of third-party binaries, not project source)
resources/tesseract/

# Python
__pycache__/
*.pyc
.venv/
venv/
*.egg-info/

# Database
*.db
*.sqlite
*.sqlite3

# Storage (uploaded/generated documents)
storage/expense_reports/*
storage/trip_reports/*
storage/excel/*
storage/processed/*
storage/logs/*
!storage/**/.gitkeep

# Node PDF archive (backend/pdf_store) - archived copies of uploaded company PDFs, never committed
backend/pdf_archive/

# Env
.env
.env.local

# Editor/OS
.vscode/
.idea/
Thumbs.db
.DS_Store

# Logs
*.log

# ---------------------------------------------------------------------------
# Generated build / release / backup artefacts - NEVER version-controlled
# (kept on disk locally; GitHub rejects files over 100 MB, and installers are
# build outputs, not source). Specific paths only: no blanket *.exe / *.zip.
# ---------------------------------------------------------------------------
/release-*/
/backups/pre-*/
/backups/release-*/
/packaging-validation-*/build/
/packaging-validation-*/debug_probe/
/packaging-validation-*/tmp*/
/packaging-validation-*/userdata*/
**/win-unpacked/
*.exe.backup-*